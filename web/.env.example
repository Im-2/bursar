# Copy to web/.env.local (git-ignored). On Vercel, set the same names under Project Settings ->
# Environment Variables instead. Only VITE_-prefixed variables reach the browser, and they are read
# at build time, so redeploy after changing one.
# This app is read-only and needs NO private keys. Never put a key or secret here:
# everything in a VITE_ variable is bundled into public JavaScript.

# Arbitrum Sepolia JSON-RPC endpoint. Defaults to the public endpoint below.
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Backup endpoint, used only if the primary request fails (the official endpoint occasionally sends a
# malformed CORS header to browsers). Leave empty to disable the fallback.
VITE_RPC_FALLBACK_URL=https://arbitrum-sepolia-rpc.publicnode.com

# How often the dashboard re-reads the chain, in milliseconds (default 6000).
VITE_POLL_MS=6000

# WalletConnect Cloud project id (https://cloud.reown.com). Enables the WalletConnect option for
# mobile and non-installed wallets. If empty, that option is hidden and the app logs a warning.
# Format: 32 hex characters, e.g. 0123456789abcdef0123456789abcdef (placeholder; left empty below so
# a copied file doesn't enable WalletConnect with an invalid id). Add your deployed domain to the
# project's allowed origins in the Reown dashboard.
VITE_WALLETCONNECT_PROJECT_ID=
