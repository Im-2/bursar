# Copy to .env and fill in. .env is git-ignored. Load it with:  source .env   (Git Bash / Linux / macOS)
#
# NO PRIVATE KEYS IN THIS FILE. Scripts sign with a key passed on the command line, preferably an
# encrypted keystore created with:  cast wallet import deployer --interactive
# and then used with:               --account deployer

# ---------------------------------------------------------------- network & verification
# RPC endpoint for Arbitrum Sepolia (chain id 421614), e.g. from Alchemy/Infura, or the public
# https://sepolia-rollup.arbitrum.io/rpc (rate-limited). Referenced in foundry.toml as `arbitrum_sepolia`.
ARBITRUM_SEPOLIA_RPC_URL=
# RPC endpoint for Arbitrum One (chain id 42161), for a later mainnet deploy. Leave empty for now.
ARBITRUM_ONE_RPC_URL=
# Explorer API key for contract verification. Arbiscan now uses the Etherscan V2 unified API, so an
# Etherscan.io API key works for both Arbitrum Sepolia and Arbitrum One.
ARBISCAN_API_KEY=

# ---------------------------------------------------------------- script/Deploy.s.sol
# true  = deploy a MockUSDG (6 decimals, public mint) and use it. Refused on Arbitrum One.
# false = use the existing stablecoin at TOKEN_ADDRESS.
DEPLOY_MOCK_TOKEN=true
# Stablecoin (e.g. USDG) address on the target chain. Required when DEPLOY_MOCK_TOKEN=false,
# and always required by Seed.s.sol (set it to the MockUSDG address printed by Deploy when using the mock).
TOKEN_ADDRESS=

# ---------------------------------------------------------------- script/Seed.s.sol (demo seeding)
# BursarFactory address printed by Deploy.s.sol.
FACTORY_ADDRESS=
# true = mint SEED_DEPOSIT tokens to the broadcaster first (MockUSDG only; refused on Arbitrum One).
# false = the broadcaster must already hold SEED_DEPOSIT tokens.
SEED_MINT=true
# All amounts below are WHOLE tokens; the script scales them by the token's decimals (6 for USDG).
SEED_DEPOSIT=10000
# Public address of the demo agent. Its private key stays with the agent, never here.
AGENT_ADDRESS=
# Role label for the agent, up to 32 ASCII characters.
AGENT_ROLE=DEMO
# Policy: perTxCap <= dailyCap and approvalThreshold <= perTxCap. APPROVAL_THRESHOLD=0 = approve everything.
PER_TX_CAP=100
DAILY_CAP=500
APPROVAL_THRESHOLD=50
# Recipient added to the agent's allowlist.
RECIPIENT_ADDRESS=
# taskId = keccak256(TASK_LABEL). Task ids can never be reused, so change the label for each new seed run.
TASK_LABEL=demo-task-1
# Must be <= SEED_DEPOSIT.
TASK_BUDGET=1000
TASK_DURATION_DAYS=7

# ---------------------------------------------------------------- agent/ (TypeScript demo)
# Private key of the DEMO AGENT (must match demo.agent.address in deployments/arbitrum-sepolia.json).
# Testnet-only key. Set it with an editor, not `echo`, so it never lands in shell history.
# The agent script never prints it and refuses to run if its address is not the demo agent.
AGENT_PRIVATE_KEY=
# Foundry keystore name the owner script signs with (default: deployer).
OWNER_ACCOUNT=deployer
