{
  "name": "bursar-agent-mcp",
  "private": true,
  "type": "module",
  "description": "MCP server that lets an AI agent spend from a Bursar vault within its on-chain policy",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "abi": "node -e \"require('fs').copyFileSync('../agent/src/abi.ts','src/abi.ts')\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
